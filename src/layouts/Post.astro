---
import Base from "./Base.astro";
import type { CollectionEntry } from "astro:content";
import { tagSlug } from "../lib/tags";

interface Props {
  entry: CollectionEntry<"posts">;
}

const { entry } = Astro.props;
const { title, description, date, tags } = entry.data;

const dateString = date.toISOString().slice(0, 10);
---

<Base title={`${title} · YuXuan255`} description={description}>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{dateString}</time>
        {
          tags.length > 0 && (
            <span class="tags">
              {tags.map((tag) => (
                <a href={`/tags/${tagSlug(tag)}/`}>#{tag}</a>
              ))}
            </span>
          )
        }
      </div>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Base>
